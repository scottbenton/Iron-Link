{
  "endOfLine": "auto",
  "importOrder": [
    "^assets/(.*)$",
    "^providers/(.*)$",
    "^components/(.*)$",
    "^ui/(.*)$",
    "^styled-system/(.*)$",
    "^pages/(.*)$",
    "^types/(.*)$",
    "^hooks/(.*)$",
    "^api-calls/(.*)$",
    "^atoms/(.*)$",
    "^stores/(.*)$",
    "^config/(.*)$",
    "^data/(.*)$",
    "^i18n/(.*)$",
    "^lib/(.*)$",
    "^tests/(.*)$",
    "^repositories/(.*)$",
    "^services/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ]
}
